<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingVertical="16dp">
    <TextView android:id="@+id/inboxApp" style="@style/DailyEyebrow" />
    <TextView android:id="@+id/inboxTitle" style="@style/DailyBody" android:textSize="20sp" android:alpha="1" />
    <TextView android:id="@+id/inboxBody" style="@style/DailyBody" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/inboxOpen" style="@style/DailyButton" android:layout_width="0dp"
            android:layout_weight="1" android:text="@string/pause_open" />
        <Button android:id="@+id/inboxDone" style="@style/DailyButton" android:layout_width="0dp"
            android:layout_weight="1" android:text="@string/daily_done" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/primaryColorTrans25" />
</LinearLayout>
