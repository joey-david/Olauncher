<?xml version="1.0" encoding="utf-8"?>
<!-- Frameless focus readout at the bottom of home: the time, a hairline of what's left, a caption.
     Tap to choose the length and locked apps and start; a running session shows a lock and can't be ended here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/focusRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginBottom="48dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <LinearLayout
        android:id="@+id/focusToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/focusTime"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textSize="40sp"
            tools:text="25 min" />

        <ProgressBar
            android:id="@+id/focusProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/focus_progress" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/focusLock"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:alpha="0.7"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/focusCaption"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:letterSpacing="0.08"
            android:paddingVertical="10dp"
            android:textAllCaps="true"
            android:textSize="11sp"
            tools:text="Start focus" />
    </LinearLayout>
</LinearLayout>
