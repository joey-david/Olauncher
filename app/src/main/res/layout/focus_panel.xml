<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="bottom" android:layout_marginHorizontal="24dp"
    android:layout_marginBottom="40dp" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/rounded_rect_shade_color">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/focusToggle" style="@style/TextMedium"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center_vertical" android:focusable="true" android:clickable="true"
            android:text="@string/focus_start" />
        <TextView android:id="@+id/focusSettings" style="@style/TextSmall"
            android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
            android:focusable="true" android:clickable="true" android:text="⚙"
            android:contentDescription="@string/focus_options" />
    </LinearLayout>
    <ProgressBar android:id="@+id/focusProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:max="1000"
        android:progress="1000" android:progressDrawable="@drawable/focus_progress" />
    <TextView android:id="@+id/focusGuardStatus" style="@style/TextSmall"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:textSize="12sp" android:text="@string/focus_guard_off" />
</LinearLayout>
